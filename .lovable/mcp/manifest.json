{
  "version": 1,
  "sdk_version": "0.20.0",
  "path": "/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "pomah-guesthouse-mcp",
      "version": "0.1.0",
      "title": "Pomah Guesthouse"
    },
    "tools": [
      {
        "name": "list_room_types",
        "title": "List room types",
        "description": "List public room types at Pomah Guesthouse with base rate, capacity, and short description.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "check_availability",
        "title": "Check room availability",
        "description": "Check available room types at Pomah Guesthouse for a given check-in / check-out date range (YYYY-MM-DD).",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "check_in": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Check-in date, format YYYY-MM-DD."
            },
            "check_out": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Check-out date, format YYYY-MM-DD."
            },
            "guests": {
              "description": "Number of guests (optional).",
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "check_in",
            "check_out"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
