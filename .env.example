# Copy to .env and fill in. NOTE: .env itself is intentionally committed —
# the Lovable build reads it from the repo (see commit d69f6d11, which restored
# it after an earlier attempt to untrack it broke the build). Only values that
# are safe to publish belong in it.
#
# Anything that is a real credential (service_role keys, API tokens, webhook
# secrets) must NOT go here — put it in the Supabase / Cloudflare / Lovable
# dashboard as a runtime env var instead.

# --- Supabase (client-side; both the bare and VITE_ copies are required) ---
# Publishable "anon" key only. It ships to the browser by design.
# The service_role key must never appear in this file.
SUPABASE_PROJECT_ID=your-project-ref
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-key

VITE_SUPABASE_PROJECT_ID=your-project-ref
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# --- WPPConnect (WhatsApp) ---
# Consumed by supabase/functions/send-review-request via Deno.env, so these are
# set in the Supabase dashboard for deployed functions; listed here for local runs.
WPP_BASE_URL=https://your-wppconnect-host
WPP_SESSION=your-session-name
