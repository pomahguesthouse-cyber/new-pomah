<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- Matches the light admin header. Shown behind the transparent status
             bar before the WebView paints, and in the gap when an older WebView
             is padded by SystemBars instead of drawing edge-to-edge. -->
        <item name="android:windowBackground">#F7FBF8</item>
        <item name="android:statusBarColor">#F7FBF8</item>
        <item name="android:navigationBarColor">#F7FBF8</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <!-- Report side cutouts (Fold inner camera on the right) as insets. -->
        <item name="android:windowLayoutInDisplayCutoutMode">always</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">#1B3F3F</item>
        <!-- A static bitmap. The adaptive ic_launcher xml crashes the Android 12+ splash on some devices. -->
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>